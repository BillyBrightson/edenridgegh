# Eden Ridge — public site (docroot: /public)
#
# nginx equivalent:
#   location / { try_files $uri $uri/ /index.php?$query_string; }
#   location ~* \.(webp|jpg|jpeg|png|svg|css|js|woff2)$ { expires 1y; add_header Cache-Control "public, immutable"; }
#   location ~ /\.(?!well-known) { deny all; }

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (skip when the host terminates TLS upstream and sets the header).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # www -> apex
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Everything that is not a real file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css   "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

# Generated derivatives are content-hashed, so they can be cached forever.
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Never serve dotfiles or a stray database.
<FilesMatch "^\.|\.(sqlite|sqlite-wal|sqlite-shm|log|md)$">
    Require all denied
</FilesMatch>
